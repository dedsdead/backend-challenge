# PostgreSQL (system of record)
DATABASE_URL=postgres://postgres:local@localhost:5432/wagering

# SQS via LocalStack
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# AWS
AWS_REGION=us-east-1

# Keycloak (OIDC)
KEYCLOAK_ISSUER=http://localhost:8080/realms/wagering
KEYCLOAK_AUDIENCE=wagering-api

# App
# HOST: 127.0.0.1 (loopback, default) or 0.0.0.0 (expose on LAN) — nothing else accepted
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# WORKERS_ENABLED: literal lowercase true|false only
WORKERS_ENABLED=true
